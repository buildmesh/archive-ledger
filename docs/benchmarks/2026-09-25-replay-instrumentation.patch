+// RESEARCH COPY ONLY. Read-only SQLite counters and process I/O snapshots.
+// Counter high-water values are included as supplied by SQLite; HIT/MISS/
+// WRITE/SPILL totals are connection-local current values, never reset here.
+fn rebuild_diagnostic(phase: &str, connection: Option<&Connection>, details: Value) {
+    use std::io::Write as _;
+    static START: std::sync::OnceLock<std::time::Instant> = std::sync::OnceLock::new();
+    let elapsed = START
+        .get_or_init(std::time::Instant::now)
+        .elapsed()
+        .as_secs_f64();
+    let mut sqlite = serde_json::Map::new();
+    if let Some(connection) = connection {
+        for (name, operation) in [
+            ("cache_hit", rusqlite::ffi::SQLITE_DBSTATUS_CACHE_HIT),
+            ("cache_miss", rusqlite::ffi::SQLITE_DBSTATUS_CACHE_MISS),
+            ("cache_write", rusqlite::ffi::SQLITE_DBSTATUS_CACHE_WRITE),
+            ("cache_spill", rusqlite::ffi::SQLITE_DBSTATUS_CACHE_SPILL),
+            (
+                "cache_used_bytes",
+                rusqlite::ffi::SQLITE_DBSTATUS_CACHE_USED,
+            ),
+        ] {
+            let mut current = 0;
+            let mut highwater = 0;
+            // SAFETY: this live Connection is borrowed on its owning thread.
+            // sqlite3_db_status reads counters synchronously, resetFlag=0; the
+            // handle and output pointers are not retained or used concurrently.
+            let code = unsafe {
+                rusqlite::ffi::sqlite3_db_status(
+                    connection.handle(),
+                    operation,
+                    &mut current,
+                    &mut highwater,
+                    0,
+                )
+            };
+            sqlite.insert(
+                name.to_owned(),
+                if code == rusqlite::ffi::SQLITE_OK {
+                    json!({"current": current, "highwater": highwater})
+                } else {
+                    json!({"sqlite_error_code": code})
+                },
+            );
+        }
+    }
+    let io: BTreeMap<String, u64> = fs::read_to_string("/proc/self/io")
+        .unwrap_or_default()
+        .lines()
+        .filter_map(|line| {
+            let (key, value) = line.split_once(':')?;
+            Some((key.to_owned(), value.trim().parse().ok()?))
+        })
+        .collect();
+    let event = json!({
+        "rebuild_diagnostic": 1, "pid": std::process::id(), "phase": phase,
+        "elapsed_seconds": elapsed,
+        "unix_seconds": std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)
+            .ok().map(|duration| duration.as_secs_f64()),
+        "sqlite": sqlite, "process_io": io, "details": details,
+    });
+    // Diagnostics must not turn successful validation into an error or skip it.
+    // In particular, a broken stderr pipe is not allowed to panic the rebuild.
+    if let Ok(line) = serde_json::to_string(&event) {
+        let _ = writeln!(std::io::stderr().lock(), "{line}");
+    }
+}
