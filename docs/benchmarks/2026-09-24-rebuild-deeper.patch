+// PRIVATE DISPOSABLE PROTOTYPE: flags affect newly constructed databases only.
+// This is an experiment, not a supported product configuration interface.
+#[derive(Clone, Copy, Default)]
+struct RebuildExperiment {
+    cache64: bool,
+    cache256: bool,
+    group16: bool,
+    group64: bool,
+    prepared: bool,
+    defer: bool,
+    wal: bool,
+    scratch: bool,
+    scratchsync: bool,
+}
+
+impl RebuildExperiment {
+    fn from_environment() -> Result<Self> {
+        let mut options = Self::default();
+        for flag in std::env::var("ARCHIVE_REBUILD_EXPERIMENT")
+            .unwrap_or_default()
+            .split(',')
+            .filter(|flag| !flag.is_empty())
+        {
+            match flag {
+                "cache64" => options.cache64 = true,
+                "cache256" => options.cache256 = true,
+                "group16" => options.group16 = true,
+                "group64" => options.group64 = true,
+                "prepared" => options.prepared = true,
+                "defer" => options.defer = true,
+                "wal" => options.wal = true,
+                "scratch" => options.scratch = true,
+                "scratchsync" => options.scratchsync = true,
+                _ => {
+                    return Err(V2ProjectionError::Invalid(format!(
+                        "unknown private rebuild experiment flag: {flag}"
+                    )))
+                }
+            }
+        }
+        if (options.scratch && options.wal)
+            || (options.scratchsync && options.wal)
+            || (options.scratchsync && options.scratch)
+        {
+            return Err(V2ProjectionError::Invalid(
+                "conflicting private rebuild journal flags: use only one of scratch, scratchsync, wal".to_owned(),
+            ));
+        }
+        if options.cache64 && options.cache256 {
+            return Err(V2ProjectionError::Invalid(
+                "conflicting private rebuild cache flags: cache64 and cache256".to_owned(),
+            ));
+        }
+        if options.group16 && options.group64 {
+            return Err(V2ProjectionError::Invalid(
+                "conflicting private rebuild transaction flags: group16 and group64".to_owned(),
+            ));
+        }
+        Ok(options)
+    }
+
+    // Explicit candidates only: keep every UNIQUE/PK index and the five
+    // nonunique indexes needed by complete-scan replay. Other mixed-history
+    // effects (including FK parent updates) still require benchmarking.
+    fn defer_indexes(self, connection: &Connection, path: &Path) -> Result<Vec<String>> {
+        if !self.defer {
+            return Ok(Vec::new());
+        }
+        let names = [
+            "records_kind_time",
+            "records_batch_dot",
+            "sites_status_name",
+            "policies_status_name",
+            "collections_status_name",
+            "devices_status_name",
+            "archive_roots_status_name",
+            "locations_status_name",
+            "locations_device",
+            "locations_site",
+            "locations_root",
+            "device_mounts_root_time",
+            "device_mounts_device_time",
+            "risk_domains_status_name",
+            "object_hashes_lookup",
+            "file_refs_object",
+            "file_refs_external_identity",
+            "copy_claims_object_state",
+            "copy_claims_external_state",
+            "copy_claims_verification_age",
+            "copy_claims_risk_eligible",
+            "scan_runs_location_finished",
+            "scan_runs_status",
+            "scan_candidates_copy_claim",
+            "job_items_job_status",
+            "annex_imports_location",
+        ];
+        let mut definitions = Vec::with_capacity(names.len());
+        for name in names {
+            let sql: String = connection.query_row(
+                "SELECT sql FROM sqlite_schema WHERE type = 'index' AND name = ?1 AND sql LIKE 'CREATE INDEX %'",
+                [name], |row| row.get(0),
+            ).map_err(|source| sqlite_error(path, source))?;
+            connection
+                .execute_batch(&format!("DROP INDEX {name};"))
+                .map_err(|source| sqlite_error(path, source))?;
+            definitions.push(sql);
+        }
+        Ok(definitions)
+    }
+
+    fn configure(self, connection: &Connection, path: &Path) -> Result<()> {
+        // Unpublished disposable output only: any replay failure abandons this
+        // database. Never used by public apply or on the installed projection.
+        if self.scratch {
+            connection
+                .execute_batch("PRAGMA journal_mode = OFF; PRAGMA synchronous = OFF;")
+                .map_err(|source| sqlite_error(path, source))?;
+        }
+        if self.scratchsync {
+            connection
+                .execute_batch("PRAGMA journal_mode = DELETE; PRAGMA synchronous = OFF;")
+                .map_err(|source| sqlite_error(path, source))?;
+        }
+        if self.wal {
+            connection
+                .execute_batch("PRAGMA journal_mode = WAL; PRAGMA synchronous = FULL;")
+                .map_err(|source| sqlite_error(path, source))?;
+        }
+        if self.cache64 || self.cache256 {
+            connection
+                .execute_batch(if self.cache256 {
+                    "PRAGMA cache_size = -262144;"
+                } else {
+                    "PRAGMA cache_size = -65536;"
+                })
+                .map_err(|source| sqlite_error(path, source))?;
+        }
+        if self.prepared {
+            connection.set_prepared_statement_cache_capacity(32);
+        }
+        Ok(())
+    }
+}
