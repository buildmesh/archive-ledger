# Copy this file to .env and use absolute host paths. Create both directories
# before running Compose; Compose is configured not to create missing sources.
ARCHIVE_LEDGER_STATE_DIR=/home/you/.local/share/archive-ledger-container
ARCHIVE_LEDGER_LOCATIONS_DIR=/mnt/archive-ledger

# Archive Roots appear beneath this directory inside the container. Keeping this
# value stable preserves mount observations for unidentified filesystems.
ARCHIVE_LEDGER_CONTAINER_LOCATIONS_DIR=/locations

# Match the owner of ARCHIVE_LEDGER_STATE_DIR and readable Location content.
ARCHIVE_LEDGER_UID=1000
ARCHIVE_LEDGER_GID=1000

# Keep this stable. Use a different value from native invocations when their
# mount paths differ from the container paths.
ARCHIVE_LEDGER_HOST_ID=workstation-docker

# Networking is disabled by default. For a single remote sync/clone command, use
# ARCHIVE_LEDGER_NETWORK_MODE=bridge docker compose run --rm archive sync ...
# Leave this unset here to keep ordinary commands offline.
